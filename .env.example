ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL in Docker; SQLite works for a single local worker:
# DATABASE_URL=sqlite+aiosqlite:///./evaluator.db
DATABASE_URL=postgresql+asyncpg://evaluator:evaluator@db:5432/evaluator
SAMPLE_RATE=0.10
MAX_PROMPT_CHARS=32000

# Any OpenAI-compatible primary endpoint. Keep "mock" for a no-key demo.
PRIMARY_PROVIDER=mock
PRIMARY_BASE_URL=https://llm-provider.example/v1
PRIMARY_API_KEY=
PRIMARY_MODEL=primary-model

# The candidate may use the same provider or a different one.
CANDIDATE_PROVIDER=mock
CANDIDATE_BASE_URL=https://llm-provider.example/v1
CANDIDATE_API_KEY=
CANDIDATE_MODEL=candidate-model
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# "heuristic" is free. "llm" uses the judge settings below.
SCORE_BACKEND=heuristic
JUDGE_BASE_URL=https://llm-provider.example/v1
JUDGE_API_KEY=
JUDGE_MODEL=judge-model

# database | sqs | azure
QUEUE_BACKEND=database
QUEUE_VISIBILITY_SECONDS=120
QUEUE_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=2

# AWS SQS uses the normal AWS credential chain.
AWS_REGION=us-east-1
SQS_QUEUE_URL=

AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE_NAME=
