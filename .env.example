PROJECT_NAME="Generic Interview API"
ENVIRONMENT="development"
LOG_LEVEL="DEBUG"
PORT=8000
# DATABASE_URL="postgresql://user:password@localhost:5432/appdb"

# Candidate (shadow) model — DigitalOcean Serverless Inference
CANDIDATE_BASE_URL="https://inference.do-ai.run/v1"
# Options: "openai-gpt-5-mini" (fast/cheap) or "openai-gpt-5"
CANDIDATE_MODEL="openai-gpt-5-mini"
# Secret — create under Control Panel: Inference → Model Access Keys (sk-do-... / doo_v1_...)
MODEL_ACCESS_KEY=""
CANDIDATE_TIMEOUT_S=30.0
CANDIDATE_MAX_RETRIES=2
